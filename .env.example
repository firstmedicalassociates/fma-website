# Amazon SES: all contact/inquiry emails and medical-records PDFs (server only).
SES_REGION=us-east-1
SES_FROM_EMAIL=info@drsfirst.com
SES_FROM_NAME=First Medical Associates
# Optional SES configuration set, in the same region as the sender identity.
SES_CONFIGURATION_SET=
# On Vercel, use the project's send-only OIDC role (no stored AWS keys).
AWS_ROLE_ARN=
# Outside Vercel, the standard AWS credential chain is supported instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only when using temporary AWS credentials.
AWS_SESSION_TOKEN=
CONTACT_TO_EMAILS=info@drsfirst.com,citryn.contactforms@gmail.com
# Optional practice transition inbox(es); otherwise uses CONTACT_TO_EMAILS.
PRACTICE_TO_EMAILS=
# Used ONLY by the explicit synthetic smoke-test script, never as a live CC.
SES_TEST_TO_EMAIL=ghough@citryn.com
CONTACT_FORM_VENDOR_REVIEWED=false

# Separate existing gate for patient-information delivery; review the SES/hosting
# arrangements before enabling. Only MedicalRecords@drsfirst.com receives records.
MEDICAL_RECORDS_VENDOR_REVIEWED=false

# Admin authentication (existing installation)
DATABASE_URL=
DIRECT_URL=
ADMIN_AUTH_SECRET=
# Used only to create the initial administrator when seeding; existing passwords are preserved.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public search and privacy-safe analytics
OPENAI_API_KEY=
AI_SEARCH_EVENT_SECRET=
# Optional reported project costs. This is a separate organization admin key.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=

# ADP Workforce Now: OAuth client credentials + mutual TLS (server only).
# ADP_API_KEY is not used: a single API key is insufficient for this API.
# Create a Job Requisitions read project in ADP API Central; see docs/adp-job-requisitions.md.
ADP_CLIENT_ID=
ADP_CLIENT_SECRET=
ADP_CERT_PATH=.adp/client-cert.pem
ADP_KEY_PATH=.adp/client-key.pem
# On hosting, use server-only PEM secrets instead of local file paths.
# Paste complete PEM blocks, including BEGIN/END lines. Literal \n is also supported.
ADP_CERT_PEM=
ADP_KEY_PEM=
# Only needed if the private key is encrypted.
ADP_KEY_PASSPHRASE=
