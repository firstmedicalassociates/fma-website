generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String // bcrypt hash
  role               String   @default("ADMIN")
  permissions        String[] @default([])
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  sessionVersion     Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  metaTitle       String?
  metaDescription String?
  slug            String    @unique
  category        String    @default("Uncategorized")
  excerpt         String?
  contentHtml     String
  coverImageUrl   String?
  coverImageAlt   String?
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt     DateTime?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@index([status, publishedAt])
  @@index([status, category, publishedAt])
}

model Provider {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  title                String
  bio                  String
  imageUrl             String
  imageAlt             String?
  linkUrl              String?
  zocdocUrl            String?
  athenaProviderId     String?
  athenaDepartmentId   String?
  athenaSchedulingName String?
  locations            String[] @default([])
  languages            String[] @default([])
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([name])
  @@index([athenaProviderId])
  @@index([isActive, sortOrder, name])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String   @default("General Care")
  title       String
  description String
  icon        String   @default("medical_services")
  pageContent Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder, title])
  @@index([category, sortOrder, title])
}

model Location {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  eyebrow            String?
  accent             String?
  intro              String?
  isComingSoon       Boolean  @default(false)
  openingDateLabel   String?
  address            String
  streetAddress      String?
  addressCity        String?
  addressState       String?
  postalCode         String?
  addressCountry     String?
  displayAddress     String?
  phone              String?
  directPhone        String?
  callTextPhone      String?
  hideOfficePhone    Boolean  @default(false)
  directionsUrl      String?
  bookingUrl         String?
  reviewUrl          String?
  mapImageUrl        String?
  mapImageAlt        String?
  parkingTitle       String?
  parkingDescription String?
  officeHours        Json     @default("[]")
  infoSections       Json     @default("[]")
  serviceIds         String[] @default([])
  services           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([updatedAt])
}

model SearchEmbedding {
  id        String                       @id @default(cuid())
  content   String
  embedding Unsupported("vector(1536)")?
  metadata  Json
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([createdAt])
}

model AiSearchEvent {
  id                     String                @id @default(cuid())
  queryHash              String?
  answerHash             String?
  queryLength            Int                   @default(0)
  surface                String                @default("api")
  intent                 String?
  status                 String                @default("unknown")
  code                   String?
  resultCount            Int                   @default(0)
  sourceCount            Int                   @default(0)
  appointmentOptionCount Int                   @default(0)
  aiConfidence           String?
  grounded               Boolean               @default(false)
  disclaimer             Boolean               @default(false)
  latencyMs              Int?
  phiCategories          String[]              @default([])
  feedbackRating         String?
  feedbackTags           String[]              @default([])
  feedbackCreatedAt      DateTime?
  feedbackQuerySnapshot  String?
  feedbackAnswerSnapshot String?
  feedbackSnapshotStatus String?
  feedbackReviewStatus   String?
  feedbackReviewNotes    String?
  feedbackReviewedAt     DateTime?
  feedbackReviewedBy     String?
  searchRoute            String?
  promptVersion          String?
  modelVersion           String?
  knowledgeVersion       String?
  sourceRefs             String[]              @default([])
  retrievalScore         Float?
  availabilityStatus     String?
  telemetryVersion       Int?
  bookingTargetCount     Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  evalCase               AiSearchEvalCase?
  interactions           AiSearchInteraction[]
  apiUsage               AiApiUsage[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([code, createdAt])
  @@index([intent, createdAt])
  @@index([feedbackRating, createdAt])
  @@index([feedbackReviewStatus, feedbackCreatedAt])
  @@index([searchRoute, createdAt])
  @@index([promptVersion, createdAt])
  @@index([surface, createdAt])
}

model AiSearchInteraction {
  id        String        @id
  eventId   String
  event     AiSearchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String
  targetRef String
  createdAt DateTime      @default(now())

  @@index([eventId, type])
  @@index([createdAt, type])
}

model AiApiUsage {
  id                String         @id @default(cuid())
  eventId           String?
  event             AiSearchEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  purpose           String
  operation         String
  model             String
  requestId         String?
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  estimatedCostUsd  Decimal?       @db.Decimal(20, 10)
  pricingVersion    String?
  status            String
  createdAt         DateTime       @default(now())

  @@index([eventId])
  @@index([createdAt, purpose])
}

model OpenAiCostSnapshot {
  id          String   @id
  projectId   String
  data        Json
  refreshedAt DateTime @default(now())
}

model AiSearchEvalCase {
  id                      String        @id @default(cuid())
  sourceEventId           String        @unique
  sourceEvent             AiSearchEvent @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)
  query                   String
  expectedBehavior        String
  expectedIntent          String?
  appointmentAvailability Boolean?
  expectedCode            String?
  expectedSourceUrl       String?
  requiredAnswerPhrases   String[]      @default([])
  forbiddenAnswerPhrases  String[]      @default([])
  isActive                Boolean       @default(true)
  createdBy               String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([isActive, createdAt])
}

model AdminCredentialAttempt {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
